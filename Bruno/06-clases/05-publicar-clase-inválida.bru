meta {
  name: Publicar clase inválida
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/clases
  body: json
  auth: none
}

body:json {
  {
    "titulo": "Clase rota",
    "fechaHora": "{{fechaClase}}",
    "duracionMin": 5,
    "cupo": 15
  }
}

assert {
  res.status: eq 400
  res.body.errores[0].campo: eq duracionMin
}

docs {
  `duracionMin` mínimo 15: 400.
}
