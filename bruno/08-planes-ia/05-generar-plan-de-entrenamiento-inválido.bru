meta {
  name: Generar plan de entrenamiento inválido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/planes-entrenamiento/generar
  body: json
  auth: none
}

body:json {
  {
    "nivel": "extremo",
    "dias": 3
  }
}

assert {
  res.status: eq 400
  res.body.errores[0].campo: eq nivel
}

docs {
  Se valida antes de llamar a Gemini, así no se gasta cuota.
}
