meta {
  name: Login con contraseña incorrecta
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "contraseña-incorrecta"
  }
}

assert {
  res.status: eq 401
}

docs {
  Credenciales inválidas: la API responde 401 sin dar pistas de cuál dato falló.
}
