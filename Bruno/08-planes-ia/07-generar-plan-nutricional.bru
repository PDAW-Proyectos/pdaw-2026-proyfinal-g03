meta {
  name: Generar plan nutricional
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/planes-nutricionales/generar
  body: json
  auth: none
}

body:json {
  {
    "nivel": "principiante",
    "dias": 3
  }
}

script:post-response {
  bru.setVar("planNutricionalId", res.body.id);
}

assert {
  res.status: eq 201
  res.body.origen: eq ia
}

docs {
  Igual que el de entrenamiento, también requiere Gemini. Se piden `nivel` y `dias` aunque el plan sea nutricional.
}
